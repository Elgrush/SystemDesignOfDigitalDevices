<?xml version="1.0" encoding="UTF-8"?><intel_fpga_monitor_program_project version="1.0">
    <architecture>Nios II</architecture>
    <system>
        <system_info filepath="true">../nios.sopcinfo</system_info>
        <system_sof filepath="true">../output_files/SDDD4_time_limited.sof</system_sof>
        <board>DE1-SoC</board>
        <cable>DE-SoC [3-8]</cable>
        <processor>nios2_qsys</processor>
        <reset_processor_during_load>true</reset_processor_during_load>
        <terminal>jtag_uart</terminal>
    </system>
    <program>
        <type>Assembly Program</type>
        <source_files>
            <source_file filepath="true">../ass_software/main.s</source_file>
        </source_files>
        <options>
            <start_symbol>_start</start_symbol>
        </options>
        <linker_sections type="Basic">
            <linker_section name=".text">
                <memory_device>ram.s1</memory_device>
                <base_address>0x00003000</base_address>
                <end_address>0x00003FFF</end_address>
                <required_section/>
            </linker_section>
        </linker_sections>
    </program>
</intel_fpga_monitor_program_project>
